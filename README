NAME
    Data::InfoBox - Data object for info box.

DESCRIPTION
    Data object for definition of common infobox which contains lines with
    informations. The informations are in form of text description
    (optionaly with icon and link).

SYNOPSIS
     use Data::InfoBox;

     my $obj = Data::InfoBox->new(%params);
     my $items_ar = $obj->items;
     my $title = $obj->title;

METHODS
  "new"
     my $obj = Data::InfoBox->new(%params);

    Constructor.

    *       "items"

            List of Data::InfoBox::Item items. Must be as reference to
            array.

            It's required.

    *       "title"

            Info box title as Data::Text::Simple instance.

            It's optional.

            Default value is undef.

    Returns instance of object.

  "items"
     my $items_ar = $obj->items;

    Get list of items in info box.

    Returns reference to array with Data::InfoBox::Item objects.

  "title"
     my $title = $obj->title;

    Get title.

    Returns Data::Text::Simple instance or undef.

ERRORS
     new():
             From Mo::utils::Array::check_array_object():
                     Parameter 'items' must be a array.
                             Value: %s
                             Reference: %s
                     Parameter 'items' with array must contain 'Data::InfoBox::Item' objects.
                             Value: %s
                             Reference: %s
             From Mo::utils::Array::check_array_required():
                     Parameter 'items' is required.
                     Parameter 'items' with array must have at least one item.
             From Mo::utils::check_isa():
                     Parameter '%s' must be a '%s' object.
                             Value: %s
                             Reference: %s

EXAMPLE
     use strict;
     use warnings;

     use Data::InfoBox;
     use Data::InfoBox::Item;
     use Data::Text::Simple;

     my $obj = Data::InfoBox->new(
             'items' => [
                    Data::InfoBox::Item->new(
                            'text' => Data::Text::Simple->new(
                                    'text' => 'First item',
                            ),
                    ),
                    Data::InfoBox::Item->new(
                            'text' => Data::Text::Simple->new(
                                    'text' => 'Second item',
                            ),
                    ),
             ],
             'title' => Data::Text::Simple->new(
                    'text' => 'Info box title',
             ),
     );

     # Print out.
     print 'title: '.$obj->title->text."\n";
     my $num = 0;
     foreach my $item (@{$obj->items}) {
             $num++;
             print "Item $num: ".$item->text->text."\n";
     }

     # Output:
     # title: Info box title
     # Item 1: First item
     # Item 2: Second item

DEPENDENCIES
    Mo, Mo::utils, Mo::utils::Array.

SEE ALSO
    Data::InfoBox::Item
        Data object for info box item.

    Tags::HTML::InfoBox
        Tags helper for HTML info box.

    Test::Shared::Fixture::Data::InfoBox::Street
        Street info box fixture.

